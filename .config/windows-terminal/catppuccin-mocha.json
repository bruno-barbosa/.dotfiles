{
  "_source": "https://github.com/catppuccin/windows-terminal (mocha.json + mochaTheme.json)",
  "_note": "Vendored so bootstrap.ps1 -MergeTerminalSettings works offline. scheme colours the text; theme colours the tab row and titlebar. Both are needed.",
  "scheme": {
    "name": "Catppuccin Mocha",
    "cursorColor": "#F5E0DC",
    "selectionBackground": "#585B70",
    "background": "#1E1E2E",
    "foreground": "#CDD6F4",
    "black": "#45475A",
    "red": "#F38BA8",
    "green": "#A6E3A1",
    "yellow": "#F9E2AF",
    "blue": "#89B4FA",
    "purple": "#F5C2E7",
    "cyan": "#94E2D5",
    "white": "#BAC2DE",
    "brightBlack": "#585B70",
    "brightRed": "#F38BA8",
    "brightGreen": "#A6E3A1",
    "brightYellow": "#F9E2AF",
    "brightBlue": "#89B4FA",
    "brightPurple": "#F5C2E7",
    "brightCyan": "#94E2D5",
    "brightWhite": "#A6ADC8"
  },
  "theme": {
    "name": "Catppuccin Mocha",
    "tab": {
      "background": "#1E1E2EFF",
      "unfocusedBackground": "#11111BFF"
    },
    "tabRow": {
      "background": "#11111BFF",
      "unfocusedBackground": "#181825FF"
    },
    "window": {
      "applicationTheme": "dark"
    }
  },
  "profileDefaults": {
    "colorScheme": "Catppuccin Mocha",
    "font": {
      "face": "Maple Mono NF"
    },
    "opacity": 85,
    "useAcrylic": true
  },
  "topLevel": {
    "theme": "Catppuccin Mocha"
  }
}
